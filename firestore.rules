rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.firebase.sign_in_provider == "password";
    }

    match /booths/{boothId} {
      allow read: if true;

      allow create, delete: if isAdmin();

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.isOpen == true
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["lastNumber", "totalPeople"])
          && request.resource.data.lastNumber == resource.data.lastNumber + 1
          && request.resource.data.totalPeople > resource.data.totalPeople
          && request.resource.data.totalPeople <= resource.data.totalPeople + 6
        );
    }

    match /reservations/{reservationId} {
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == "waiting"
        && request.resource.data.partySize >= 1
        && request.resource.data.partySize <= 6;

      allow read: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);

      allow update: if isAdmin()
        || (
          signedIn()
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(["status", "cancelledAt"])
          && request.resource.data.status == "cancelled"
        );

      allow delete: if isAdmin();
    }
  }
}
